# Copia este archivo a .env y llena los valores.

# --- Frontend (públicas: terminan en el bundle, protegidas por RLS) ---
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Solo CLI de Supabase (sin prefijo VITE_, nunca llegan al navegador) ---
# Project ref: el "xxxxxxxx" de la URL
SUPABASE_PROJECT_REF=
# Token personal: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Contraseña de la base de datos (Project Settings > Database)
SUPABASE_DB_PASSWORD=
